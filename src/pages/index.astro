---
import Layout from "@/layouts/Layout.astro";
import Calculator from "@/components/Calculator.tsx";
---

<Layout>
  <section class="border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-4 py-6 lg:px-6">
      <h1 class="text-xl font-semibold tracking-tight sm:text-2xl">
        settings.json calculator for Claude Code
      </h1>
      <p class="mt-1 text-xs text-[var(--color-fg-muted)] sm:text-sm">
        Build, score and export your configuration.
      </p>
    </div>
  </section>

  <Calculator client:load />
</Layout>
