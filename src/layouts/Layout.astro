---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Claudeculator — settings.json calculator for Claude",
  description = "Build your Claude Code configuration and measure security, token usage and efficiency in real time.",
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <div class="min-h-screen">
      <header class="sticky top-0 z-10 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 lg:px-6">
          <a href="/" class="flex items-center gap-2">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--color-fg)] font-mono text-sm font-bold text-[var(--color-bg)]"
            >
              C
            </span>
            <span class="font-semibold tracking-tight">Claudeculator</span>
            <span
              class="hidden rounded border border-[var(--color-border-strong)] px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--color-fg-muted)] sm:inline-block"
            >
              beta
            </span>
          </a>
          <nav class="flex items-center gap-4 text-sm text-[var(--color-fg-muted)]">
            <a
              href="https://github.com/davila7/claudeculator"
              target="_blank"
              rel="noreferrer"
              class="hover:text-[var(--color-fg)]"
            >
              GitHub →
            </a>
          </nav>
        </div>
      </header>

      <main><slot /></main>

      <section class="border-t border-[var(--color-border)] py-12">
        <div class="mx-auto max-w-6xl px-4 lg:px-6">
          <h2 class="text-center text-lg font-semibold tracking-tight">
            Want more components?
          </h2>
          <p class="mt-2 text-center text-sm text-[var(--color-fg-muted)]">
            Explore skills, agents, hooks and MCPs at aitmpl.com.
          </p>
          <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {[
              { label: "Skills", href: "https://aitmpl.com/skills" },
              { label: "Agents", href: "https://aitmpl.com/agents" },
              { label: "Hooks", href: "https://aitmpl.com/hooks" },
              { label: "MCPs", href: "https://aitmpl.com/mcps" },
            ].map((card) => (
              <a
                href={card.href}
                target="_blank"
                rel="noreferrer"
                class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-4 py-5 text-center transition hover:border-[var(--color-border-strong)] hover:bg-[var(--color-bg-hover)]"
              >
                <div class="text-sm font-semibold text-[var(--color-fg)]">{card.label}</div>
                <div class="mt-1 font-mono text-xs text-[var(--color-fg-muted)] group-hover:text-[var(--color-fg)]">
                  aitmpl.com/{card.label.toLowerCase()} →
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <footer class="border-t border-[var(--color-border)] py-8 text-center text-xs text-[var(--color-fg-muted)]">
        <div class="mx-auto max-w-6xl px-4 lg:px-6">
          Not an official Anthropic website. Open-source project by
          {" "}
          <a
            href="https://x.com/dani_avila7"
            target="_blank"
            rel="noreferrer"
            class="text-[var(--color-fg)] underline-offset-2 hover:underline"
          >
            Daniel Avila
          </a>.
        </div>
      </footer>
    </div>
  </body>
</html>
